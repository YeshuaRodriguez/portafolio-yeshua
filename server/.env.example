# Copiar a server/.env y completar
RESEND_API_KEY=
# Remitente, debe ser de un dominio verificado en Resend. Ej: "Portfolio <contact@mail.tudominio.dev>"
MAIL_FROM=
# Correo que recibe los mensajes del formulario
MAIL_TO=
# Turnstile en local: secret de prueba de Cloudflare que siempre aprueba (el front usa la site key de prueba en dev)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Vacío en local para no exigir el hostname de producción (en prod viene de wrangler.jsonc)
TURNSTILE_HOSTNAMES=
