// Worker del frontend: sirve el build estático de Vite (dist/).
// La API (server/) se despliega como un Worker aparte en la ruta /api/*.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portafolio-yeshua",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // BrowserRouter: cualquier ruta sin archivo devuelve index.html
    "not_found_handling": "single-page-application"
  }
}
